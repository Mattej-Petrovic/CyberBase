#: templates/commands.html:658
msgid "[options] means optional flags you can add, like -p or --name"
msgstr ""
"[options] betyder valfria flaggor som du kan lägga till, som -p eller --name"

#: templates/commands.html:659
msgid "<container> and <image> are placeholders, replace them with real names"
msgstr "<container> och <image> är platshållare, ersätt dem med riktiga namn"

#: templates/commands.html:660
msgid "[<container>...] means you can repeat it for multiple containers"
msgstr "[<container>...] betyder att du kan upprepa det för flera containrar"

#: templates/commands.html:661
msgid ""
"<command> [<arg>...] means a command to run inside the container plus "
"optional arguments"
msgstr ""
"<command> [<arg>...] betyder ett kommando som körs i containern plus valfria"
" argument"

#: templates/commands.html:666 templates/commands.html:673
msgid "<arg>, <path>, <name> are placeholders, replace them with real values"
msgstr "<arg>, <path>, <name> är platshållare, ersätt dem med verkliga värden"

#: templates/commands.html:668 templates/commands.html:675
msgid "<subcommand> means choose exactly one subcommand"
msgstr "<subcommand> betyder att du väljer exakt ett delkommando"

#: templates/commands.html:679
msgid ""
"db.<collection> means replace <collection> with a real collection name, like"
" db.users"
msgstr ""
"db.<collection> betyder att du ersätter <collection> med ett verkligt "
"samlingsnamn, till exempel db.users"

#: templates/commands.html:680
msgid "( ... ) contains method arguments, separated by commas"
msgstr "( ... ) innehåller metodargument, separerade med kommatecken"

#: templates/commands.html:681
msgid ""
"<query>, <filter>, <projection> are placeholders for MongoDB query documents"
msgstr ""
